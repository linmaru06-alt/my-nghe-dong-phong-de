# ================================================================
# MỸ NGHỆ ĐÔNG PHONG - BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Copy file này thành .env.local (chạy cục bộ) hoặc thêm vào
# Project Settings > Environment Variables trên Vercel
# ================================================================

# 1. CẤU HÌNH CLOUDINARY (Lưu ảnh đám mây vĩnh viễn cho Vercel & Production)
# Lấy miễn phí tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 2. KHÓA BẢO MẬT ADMIN TOKEN
ADMIN_JWT_SECRET=dongphong-artisan-woodcraft-secret-key-2026-verified

# 3. CẤU HÌNH SUPABASE (Database & Storage)
# Lấy tại Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# 4. API (Tùy chọn nếu có Backend rời)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
